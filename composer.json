{
    "name": "survos/media-topics",
    "description": "IPTC Media Topics and Genre as a PHP library: the pinned vocabularies with hierarchy, translations, Wikidata and Subject Code mappings",
    "keywords": ["iptc", "media-topics", "genre", "newscodes", "taxonomy", "vocabulary", "classification"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Tac Tacelosky",
            "email": "tacman@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Survos\\MediaTopics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\MediaTopics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
